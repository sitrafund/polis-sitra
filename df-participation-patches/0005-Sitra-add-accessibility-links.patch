diff --git a/src/app/components/Footer.tsx b/src/app/components/Footer.tsx
index cb762b3..7487703 100644
--- a/src/app/components/Footer.tsx
+++ b/src/app/components/Footer.tsx
@@ -25,6 +25,7 @@ export default async function Footer({ locale }: FooterProps) {
             <ul className="flex flex-col w-full sm:w-1/3 list-none lg:px-12">
               <li><h2 className="text-2xl font-bold m-0">{t('footer.links.title')}</h2></li>
               <li className="m-2.5"><a target="_blank" rel="noreferrer" className="border-0" href={t('footer.links.privacy_href')}>{t('footer.links.privacy')}</a></li>
+              <li className="m-2.5"><a target="_blank" rel="noreferrer" className="border-0" href={t('footer.links.accessibility_href')}>{t('footer.links.accessibility')}</a></li>
               <li className="m-2.5"><a target="_blank" rel="noreferrer" className="border-0" href={t('footer.links.info_href')}>{t('footer.links.info')}</a></li>
               <li className="m-2.5"><a target="_blank" rel="noreferrer" className="border-0" href="https://compdemocracy.org/Welcome/">The Computational Democracy Project</a></li>
               <li className="m-2.5"><a target="_blank" rel="noreferrer" className="border-0" href="https://github.com/polis-digifinland/polis-digifinland">{t('footer.links.source')}</a></li>
