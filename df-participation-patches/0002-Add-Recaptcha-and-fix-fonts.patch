+// Google reCAPTCHA v3 utility functions
+
+/**
+ * Load the Google reCAPTCHA v3 script dynamically
+ * @param siteKey - Your reCAPTCHA site key
+ * @returns A promise that resolves when the script is loaded
+ */
+export const loadReCaptchaScript = (siteKey: string): Promise<void> => {
+  return new Promise((resolve, reject) => {
+    // First, remove any existing reCAPTCHA scripts and reset state
+    const existingScripts = document.querySelectorAll('script[src*="recaptcha"]');
+    existingScripts.forEach(script => script.remove());
+    
+    // Also remove the grecaptcha badge if it exists
+    const badge = document.querySelector('.grecaptcha-badge');
+    if (badge) {
+      badge.remove();
+    }
+    
+    // Reset the window.grecaptcha object
+    if (window.grecaptcha) {
+      window.grecaptcha = undefined;
+    }
+
+    // Create script element with font isolation
+    const script = document.createElement('script');
+    script.src = `https://www.google.com/recaptcha/api.js?render=${siteKey}`;
+    script.async = true;
+    script.defer = true;
+    
+    // Add attributes to prevent font interference
+    script.setAttribute('data-font-isolation', 'true');
+    
+    // Handle script load and error events
+    script.onload = () => {
+      // Use a timeout to ensure the API is fully initialized
+      setTimeout(() => {
+        if (window.grecaptcha && window.grecaptcha.ready) {
+          window.grecaptcha.ready(() => {
+            console.log('reCAPTCHA script loaded');
+            
+            // Force font re-rendering after reCAPTCHA loads
+            const fontElements = document.querySelectorAll('.font-primary');
+            fontElements.forEach(el => {
+              const element = el as HTMLElement;
+              element.style.fontFamily = getComputedStyle(element).fontFamily;
+            });
+            
+            resolve();
+          });
+        } else {
+          reject(new Error('reCAPTCHA script loaded but API not available'));
+        }
+      }, 500);
+    };
+    script.onerror = (error) => {
+      reject(new Error(`ReCAPTCHA script failed to load: ${error}`));
+    };
+    
+    // Add script to document head (not body to prevent layout shifts)
+    document.head.appendChild(script);
+  });
+};
+
+/**
+ * Execute reCAPTCHA and get a token
+ * @param siteKey - Your reCAPTCHA site key
+ * @param action - The action name for analytics (e.g., 'vote')
+ * @returns A promise that resolves with the reCAPTCHA token
+ */
+export const executeReCaptcha = async (siteKey: string, action: string): Promise<string> => {
+  if (!window.grecaptcha || !window.grecaptcha.execute) {
+    try {
+      await loadReCaptchaScript(siteKey);
+    } catch (error) {
+      console.error('Failed to load reCAPTCHA:', error);
+      throw new Error('Failed to load reCAPTCHA');
+    }
+  }
+
+  try {
+    // Always get a fresh token for each request since tokens can only be verified once
+    const token = await window.grecaptcha?.execute(siteKey, { action });
+    return token ?? '';
+  } catch (error) {
+    console.error('reCAPTCHA execution failed:', error);
+    throw new Error('reCAPTCHA verification failed');
+  }
+};
+
+// Add TypeScript definition for global window object
+declare global {
+  interface Window {
+    grecaptcha: {
+      ready: (cb: () => void) => void;
+      execute: (siteKey: string, options: { action: string }) => Promise<string>;
+      _readyCallback?: () => void;
+      [key: string]: unknown;
+    } | undefined;
+  }
+} 
