diff --git a/src/app/config/environment.ts b/src/app/config/environment.ts
new file mode 100644
index 0000000..604f37d
--- /dev/null
+++ b/src/app/config/environment.ts
@@ -0,0 +1,25 @@
+/**
+ * Environment configuration for the application
+ */
+
+// In Next.js, process.env is available without type definitions
+declare const process: {
+  env: {
+    NEXT_PUBLIC_RECAPTCHA_SITE_KEY?: string;
+    NEXT_PUBLIC_EXTERNAL_API_BASE_URL?: string;
+  }
+};
+
+/**
+ * Google reCAPTCHA v3 configuration
+ */
+export const recaptchaConfig = {
+  // Replace this with your actual reCAPTCHA v3 site key
+  siteKey: process.env.NEXT_PUBLIC_RECAPTCHA_SITE_KEY || '',
+  // Action names for analytics
+  actions: {
+    voteAgree: 'vote_agree',
+    voteDisagree: 'vote_disagree',
+    votePass: 'vote_pass'
+  }
+};
